<setup xmlns="https://www.benerator.de/schema/3.0.0">
    <database id="db" environment="conf" system="db"/>
    <generate type="customers" count="20" consumer="db">
        <attribute name="id" type="int" min="1" max="1000000"/>
        <attribute name="name" pattern="[A-Z][a-z]{5}"/>
    </generate>
</setup>
