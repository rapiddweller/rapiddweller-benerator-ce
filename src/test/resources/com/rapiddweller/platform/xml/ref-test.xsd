<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="ref-test.xsd" xmlns="ref-test.xsd"
           elementFormDefault="qualified">
    <xs:element name="color" type="xs:string"/>
    <xs:element name="catalog">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="color"/>
                <xs:element name="item" type="xs:string" maxOccurs="unbounded" nillable="false"/>
            </xs:sequence>
        </xs:complexType>
        <xs:key name="k">
            <xs:selector xpath="item"/>
            <xs:field xpath="."/>
        </xs:key>
        <xs:keyref name="kr" refer="k">
            <xs:selector xpath="item"/>
            <xs:field xpath="."/>
        </xs:keyref>
    </xs:element>
</xs:schema>
